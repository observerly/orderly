{
  "name": "@observerly/orderly",
  "version": "0.4.0",
  "description": "Single file, no pushing. Type-safe middleware that brings a little bit of order to Cloudflare Queues.",
  "keywords": [
    "cloudflare",
    "middleware",
    "queues",
    "typescript",
    "workerd",
    "workers"
  ],
  "homepage": "https://github.com/observerly/orderly#readme",
  "bugs": {
    "url": "https://github.com/observerly/orderly/issues"
  },
  "license": "MIT",
  "author": "Micheal J. Roberts <michael@observerly.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/observerly/orderly.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts --cleanDir",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:version": "changeset version",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:package": "node scripts/guard-dependencies.ts && publint && attw --pack . --ignore-rules cjs-resolves-to-esm",
    "lint:types": "oxlint --type-aware",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@observerly/astrometry": "0.69.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.0",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260811.1",
    "@types/node": "24.13.3",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "publint": "0.3.23",
    "rolldown": "1.2.4",
    "rolldown-plugin-dts": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
