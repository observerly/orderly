{
  // orderly is a library, not a Worker. This file exists only so
  // @cloudflare/vitest-pool-workers has a runtime configuration to boot
  // workerd with; nothing here is deployed.
  "name": "orderly",
  // Matches the workerd build pinned by the pool, so the runtime under test
  // and the compatibility surface it exposes cannot drift apart.
  "compatibility_date": "2026-08-11",
  // Durable Objects have to be exported from a real module for the runtime to
  // instantiate them. This points at a test fixture rather than src, because
  // the class below is scaffolding for the harness and is not part of the
  // published package. It moves into src once orderly owns a real run object.
  "main": "tests/fixtures/worker.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "RUN",
        "class_name": "Run",
      },
    ],
  },
  // Declarative class lifecycle. This replaces the older migrations array, and
  // the two are mutually exclusive: a configuration carrying both is rejected
  // outright. Since orderly has no Durable Objects in production yet, there is
  // no legacy chain to carry and the map can start clean.
  "exports": {
    "Run": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  // A producer and a consumer over the same queue, so tests can exercise both
  // ends of the middleware: sending a message, and receiving it as a batch.
  // The values mirror a realistic consumer rather than the defaults, so that
  // batching and retry behaviour is observable in tests.
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "orderly",
      },
    ],
    "consumers": [
      {
        "queue": "orderly",
        "max_batch_size": 10,
        "max_retries": 3,
      },
    ],
  },
  // A Workflow that reports the params it was created with, so tests can
  // pin how the real binding behaves: which ids it accepts, what a repeated
  // id does, and how params cross into an instance. Like the Durable Object
  // above, its class is read from the main module.
  "workflows": [
    {
      "name": "echo",
      "binding": "ECHO",
      "class_name": "Echo",
    },
  ],
}
